# Copy to deploy/rag.env ON THE SERVER and fill in. Never commit the real file.
APP_ORIGIN=https://rag.anncarlos.me
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=replace-with-a-long-random-value
# From console.groq.com -> API Keys. Keep it private.
GROQ_API_KEY=replace-with-your-groq-key
RAG_CHAT_MODEL=openai/gpt-oss-20b
RAG_MIN_SCORE=0.6
